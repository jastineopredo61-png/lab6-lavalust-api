# Copy this file to .env and fill in real values. .env is git-ignored.
APP_ENV=development

DB_DRIVER=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=lab6db

# Generate both with: php lava jwt:generate  (32+ chars, must be different)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Deployed React URL (Vercel), no trailing slash. Set on Render after frontend deploy.
FRONTEND_URL=
